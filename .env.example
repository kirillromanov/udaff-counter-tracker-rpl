DATABASE_URL="file:./dev.db"

# footballdata.io bearer token. Leave empty to skip that source.
# Do not commit a real key. .env is gitignored; this example is not.
FOOTBALLDATA_API_KEY=
# Optional public league id. When empty, the adapter searches for the Russian Premier League.
FOOTBALLDATA_LEAGUE_ID=
# Optional public season id. When empty, the current RPL season is kept from the payload.
FOOTBALLDATA_SEASON_ID=
