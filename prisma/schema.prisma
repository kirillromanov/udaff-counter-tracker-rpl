generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Season {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  rounds            Round[]
  participants      SeasonParticipant[]
  scoringConfig     ScoringConfig?
  standingSnapshots StandingSnapshot[]
  checkpoints       StandingsCheckpoint[]
  reconciliationDecisions ReconciliationDecision[]
}

model Round {
  id        String   @id @default(cuid())
  seasonId  String
  number    Int
  name      String?
  forumUrl  String?
  /// When the source thread was last downloaded.
  fetchedAt DateTime?
  /// Plain text of the opening post. Comments keep their own raw HTML.
  sourceSnapshot String?
  /// Schedule notes from the last import, such as a missing Match of the Round.
  importNotes String?
  status    String   @default("draft")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  season            Season             @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  matches           Match[]
  forumComments     ForumComment[]
  predictionSets    PredictionSet[]
  roundScores       RoundScore[]
  standingSnapshots StandingSnapshot[]

  @@unique([seasonId, number])
}

model Match {
  id                String    @id @default(cuid())
  roundId           String
  kickoffAt         DateTime?
  homeTeam          String
  awayTeam          String
  sortOrder         Int       @default(0)
  /// At most one match in a round should be the Match of the Round. Enforced in application code.
  isMatchOfTheRound Boolean   @default(false)
  actualHomeGoals   Int?
  actualAwayGoals   Int?
  /// open, confirmed, verified, conflict, or manual. Manual scores are never replaced by a fetch.
  resultState       String    @default("open")
  /// Sources disagreed, or a manual score does not match the fetched sources.
  resultConflict    Boolean   @default(false)
  resultNote        String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  round         Round                @relation(fields: [roundId], references: [id], onDelete: Cascade)
  predictions   Prediction[]
  resultObservations ResultObservation[]

  @@index([roundId])
}

/// One attempt to download a public results page. A failed source does not erase earlier rows.
model ResultFetchLog {
  id         String   @id @default(cuid())
  source     String
  url        String
  /// ok or failed
  status     String
  /// primary, fallback, or verification
  role       String   @default("fallback")
  matchCount Int      @default(0)
  error      String?
  fetchedAt  DateTime @default(now())

  @@index([fetchedAt])
}

/// Rolling health for one result source. A failed call updates this row and does not erase scores.
model ResultSourceHealth {
  source              String    @id
  /// primary, fallback, or verification
  role                String
  lastSuccessAt       DateTime?
  lastFailureAt       DateTime?
  consecutiveFailures Int       @default(0)
  degraded            Boolean   @default(false)
  lastError           String?
  updatedAt           DateTime  @updatedAt
}

/// A finished score as published by one source. Re-fetching the same match updates this row.
model ResultObservation {
  id          String   @id @default(cuid())
  source      String
  sourceKey   String
  roundNumber Int?
  homeTeam    String
  awayTeam    String
  homeGoals   Int
  awayGoals   Int
  /// primary, fallback, or verification. Verification-only rows do not confirm a score alone.
  role        String   @default("fallback")
  /// high, medium, or low
  confidence  String   @default("medium")
  matchId     String?
  fetchedAt   DateTime @default(now())

  match Match? @relation(fields: [matchId], references: [id], onDelete: SetNull)

  @@unique([source, sourceKey])
  @@index([matchId])
}

model Participant {
  id             String    @id @default(cuid())
  name           String
  forumNick      String?   @unique
  /// participantKey(name). Together with aliases, this is the duplicate check.
  /// Nullable so an existing database can take the column, then be reseeded.
  normalizedName String?   @unique
  /// Set when the person is removed from the registry. Historical scores stay.
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  aliases        ParticipantAlias[]
  seasons        SeasonParticipant[]
  predictionSets PredictionSet[]
  roundScores    RoundScore[]
  standings      StandingSnapshot[]
  checkpointRows StandingsCheckpointRow[]
  reconciliationDecisions ReconciliationDecision[]
}

model ParticipantAlias {
  id            String   @id @default(cuid())
  participantId String
  alias         String
  normalized    String   @unique
  isPrimary     Boolean  @default(false)
  createdAt     DateTime @default(now())

  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([participantId])
}

/// A forum nick that is not a contest participant. Import stores the comment and skips predictions.
model IgnoredForumAuthor {
  id         String   @id @default(cuid())
  name       String
  normalized String   @unique
  note       String?
  createdAt  DateTime @default(now())
}

model SeasonParticipant {
  id            String    @id @default(cuid())
  seasonId      String
  participantId String
  /// included: active on this season roster. excluded: kept, but not active.
  status        String    @default("included")
  joinedAt      DateTime  @default(now())
  excludedAt    DateTime?

  season      Season      @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([seasonId, participantId])
}

model ForumComment {
  id         String    @id @default(cuid())
  roundId    String
  sourceUrl  String
  externalId String?
  authorName String
  postedAt   DateTime?
  rawHtml    String
  rawText    String
  /// stored, accepted, flagged, or ignored. Flagged comments stay in review.
  reviewState String   @default("stored")
  reviewNote  String?
  /// Parse this comment even when the author is on the ignored list.
  importAnyway Boolean @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  round          Round           @relation(fields: [roundId], references: [id], onDelete: Cascade)
  predictionSets PredictionSet[]

  @@unique([roundId, externalId])
  @@index([roundId, postedAt])
}

model PredictionSet {
  id              String   @id @default(cuid())
  roundId         String
  participantId   String
  forumCommentId  String?
  source          String   @default("manual")
  rawComment      String?
  status          String   @default("draft")
  selected        Boolean  @default(false)
  /// auto: latest valid comment wins. manual: an admin chose this set.
  selection       String   @default("auto")
  confidence      Float?
  warningsJson    String   @default("[]")
  parsedJson      String   @default("[]")
  manuallyEdited  Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  round        Round         @relation(fields: [roundId], references: [id], onDelete: Cascade)
  participant  Participant   @relation(fields: [participantId], references: [id], onDelete: Cascade)
  forumComment ForumComment? @relation(fields: [forumCommentId], references: [id], onDelete: SetNull)
  predictions  Prediction[]

  @@index([roundId, participantId])
  @@index([forumCommentId])
}

model Prediction {
  id              String   @id @default(cuid())
  predictionSetId String
  matchId         String
  homeGoals       Int?
  awayGoals       Int?
  ignored         Boolean  @default(false)
  /// The comment explicitly marked this line with (МТ). Distinct from Match.isMatchOfTheRound.
  markedAsMt      Boolean  @default(false)
  rawLine         String?
  confidence      Float?
  warning         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  predictionSet PredictionSet @relation(fields: [predictionSetId], references: [id], onDelete: Cascade)
  match         Match         @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([predictionSetId, matchId])
}

model RoundScore {
  id               String   @id @default(cuid())
  roundId          String
  participantId    String
  totalPoints      Int
  matchPoints      Int
  roundBonusPoints Int
  exactCount       Int
  neighborCount    Int
  diffCount        Int
  outcomeCount     Int
  missCount        Int
  isRoundWinner    Boolean  @default(false)
  breakdownJson    String
  calculatedAt     DateTime @default(now())

  round       Round       @relation(fields: [roundId], references: [id], onDelete: Cascade)
  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([roundId, participantId])
}

model StandingSnapshot {
  id            String   @id @default(cuid())
  seasonId      String
  roundId       String
  participantId String
  rank          Int
  previousRank  Int?
  movement      String
  totalPoints   Int
  roundWins     Int
  calculatedAt  DateTime @default(now())

  season      Season      @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  round       Round       @relation(fields: [roundId], references: [id], onDelete: Cascade)
  participant Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([seasonId, roundId, participantId])
  @@index([seasonId, roundId, rank])
}

/// Trusted hand-entered season table. Separate from calculated StandingSnapshot rows.
model StandingsCheckpoint {
  id               String   @id @default(cuid())
  seasonId         String
  afterRoundNumber Int
  source           String   @default("manual")
  label            String
  rawText          String
  createdAt        DateTime @default(now())

  season Season                     @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  rows   StandingsCheckpointRow[]

  @@unique([seasonId, afterRoundNumber, source])
}

model StandingsCheckpointRow {
  id            String @id @default(cuid())
  checkpointId  String
  participantId String?
  rank          Int
  /// up, down, same, or new
  movement      String
  movementDelta Int
  previousRank  Int?
  displayName   String
  totalPoints   Int
  /// Count of ☼ markers on the forum line. In this contest those are round wins.
  markerCount   Int
  rawLine       String

  checkpoint  StandingsCheckpoint @relation(fields: [checkpointId], references: [id], onDelete: Cascade)
  participant Participant?        @relation(fields: [participantId], references: [id], onDelete: SetNull)

  @@unique([checkpointId, rank])
  @@index([participantId])
}

/// An admin choice about one reconciliation row. Never rewrites the manual checkpoint.
model ReconciliationDecision {
  id               String   @id @default(cuid())
  seasonId         String
  afterRoundNumber Int
  /// Checkpoint display name, or an unmatched forum author.
  subjectName      String
  participantId    String?
  /// accept_computed, keep_manual, alias, or manual_correction
  action           String
  note             String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  season      Season       @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  participant Participant? @relation(fields: [participantId], references: [id], onDelete: SetNull)

  @@unique([seasonId, afterRoundNumber, subjectName])
  @@index([participantId])
}

model ScoringConfig {
  id                         String   @id @default(cuid())
  seasonId                   String   @unique
  exactPoints                Int      @default(10)
  neighborPoints             Int      @default(6)
  diffPoints                 Int      @default(4)
  outcomePoints              Int      @default(3)
  missPoints                 Int      @default(-1)
  zeroTotalBonus             Int      @default(1)
  nilNilBonus                Int      @default(2)
  bigDiffBonus               Int      @default(3)
  bigDiffMin                 Int      @default(3)
  highTotalBonus             Int      @default(4)
  highTotalMin               Int      @default(5)
  roundTotalGoalsBonus       Int      @default(3)
  mtMultiplier               Int      @default(2)
  mtAppliesToNegative        Boolean  @default(true)
  bonusesRequireRewardedBase Boolean  @default(true)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)
}
