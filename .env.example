DATABASE_URL="file:./dev.db"

# footballdata.io bearer token. Leave empty to skip that source.
# Do not commit a real key. .env is gitignored; this example is not.
FOOTBALLDATA_API_KEY=
# Optional public league id. When empty, the adapter searches for the Russian Premier League.
FOOTBALLDATA_LEAGUE_ID=
# Optional public season id. When empty, the current RPL season is kept from the payload.
FOOTBALLDATA_SEASON_ID=
# Minutes between result checks for rounds that are not live. The dev server does not poll by itself.
# The fixture clock is kickoff plus 120 minutes, then every 5 minutes, up to 10 attempts.
RESULT_POLL_INTERVAL_MINUTES=60
# Shorter gap while a match is live, unverified, or waiting on a source conflict.
RESULT_POLL_LIVE_INTERVAL_MINUTES=15
# Worker. Leave these unset. The exact value 1 is required before any worker fetch.
# WORKER_ENABLED=1
# Result checks also require this second flag. WORKER_ENABLED alone does not fetch results or store scores.
# WORKER_RESULTS_ENABLED=1
# Minutes added to nextPredictionFetchAt after a prediction attempt. No default. Proposed value 60, not active.
# PREDICTION_REFRESH_INTERVAL_MINUTES=60
# Optional sleep ceiling. It does not choose the prediction or result due time.
# WORKER_SCAN_MINUTES=60
# Optional claim directory. Otherwise ~/Library/Application Support/udaff-counter-tracker/worker-locks
# WORKER_LOCK_DIR=
